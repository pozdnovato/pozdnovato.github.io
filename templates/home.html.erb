<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8"/>
<title><%= html_escape(heading) %></title>
<meta content="width=device-width, initial-scale=1" name="viewport"/>
<link href="<%= asset_url('assets/css/style.css') %>" rel="stylesheet" type="text/css"/>
<link href="/assets/images/favicon.ico" rel="shortcut icon" type="image/x-icon"/>
<link href="/assets/images/webclip.png" rel="apple-touch-icon"/>
</head>
<body>
<div class="page" id="top">

  <header class="hero about-hero">
    <div class="name-row reveal">
      <h1 class="name"><%= html_escape(heading) %></h1>
    </div>
<% if bio_paragraphs.any? -%>
    <div class="bio rich-text reveal">
<% bio_paragraphs.each do |p| -%>
      <p><%= p %></p>
<% end -%>
    </div>
<% end -%>
  </header>

  <nav class="about-links">
<% cards.each do |card| -%>
    <a href="<%= html_escape(card[:url]) %>" class="about-link<%= ' about-link--image' if card[:image] %> reveal"<% if card[:style] %> style="<%= card[:style] %>"<% end %><% unless card[:mailto] %> target="_blank" rel="noopener"<% end %>><% if card[:image] %><img class="about-link-image" src="<%= html_escape(card[:image]) %>" alt="" loading="lazy" decoding="async"/><span class="about-link-label"><%= html_escape(card[:label]) %></span><% else %><%= html_escape(card[:label]) %><% end %></a>
<% end -%>
  </nav>

</div>
<script src="<%= asset_url('assets/js/main.js') %>" defer></script>
</body>
</html>
